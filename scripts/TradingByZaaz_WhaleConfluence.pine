//@version=5
indicator("TradingByZaaz - Whale Confluence & Precision Signals [Exness Edition]", shorttitle="TBAZ Whale Confluence", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// =============================================================================
// TRADINGBYZAAZ: WHALE CONFLUENCE & PRECISION SIGNALS
// Architecture:
// 1. Real-time Live Market Highs & Lows (Fractal Swings + Session Extremes)
// 2. Dynamic Algorithmic Trendlines (Multi-touch support & resistance)
// 3. Previous Market Memory (PDH, PDL, PDC, PWH, PWL, Pivots)
// 4. Whale Order Flow & Institutional Footprint (RVOL surges, Absorption sweeps)
// 5. Asymmetric Risk Profile: Minimal Loss Margin (tight SL) -> High Win Margin (2R to 5R+)
// Optimized for Exness (Forex, Metals, Crypto, Indices) and any Stock graph.
// =============================================================================

// -----------------------------------------------------------------------------
// 1. INPUT CONFIGURATION
// -----------------------------------------------------------------------------
grp_whale = "=== 🐋 Whale & Institutional Flow ==="
rvolLen        = input.int(20, "Whale Volume Average Length", minval=5, group=grp_whale)
rvolThreshold  = input.float(1.8, "Whale Surge Multiplier (RVOL)", minval=1.2, step=0.1, group=grp_whale, tooltip="Volume must exceed this multiple of 20-SMA to qualify as institutional whale participation")
colorWhaleBars = input.bool(true, "Color Candles on Whale Activity", group=grp_whale)
showWhaleBadge = input.bool(true, "Show Whale Badges on Chart", group=grp_whale)

grp_struct = "=== 📐 Live Highs/Lows & Trendlines ==="
pivotLookback  = input.int(3, "Swing Pivot Lookback (Bars)", minval=2, maxval=15, group=grp_struct)
showTrendlines = input.bool(true, "Draw Auto Trendlines", group=grp_struct)
tlMaxLookback  = input.int(100, "Trendline Max Bars History", minval=30, maxval=300, group=grp_struct)
showSwings     = input.bool(true, "Show Live Swing Highs/Lows", group=grp_struct)

grp_prev = "=== 🏛 Previous Market Memory (PDH / PDL) ==="
showPDLevels   = input.bool(true, "Show Previous Day High & Low (PDH/PDL)", group=grp_prev)
showPWLevels   = input.bool(true, "Show Previous Week High & Low (PWH/PWL)", group=grp_prev)
showPivots     = input.bool(false, "Show Daily Floor Pivots (PP, R1, S1)", group=grp_prev)

grp_risk = "=== 🎯 Risk / Reward & Win Margin (Low Loss, High Win) ==="
slAtrMult      = input.float(1.0, "Stop Loss ATR Buffer (Low Loss Margin)", minval=0.4, step=0.1, group=grp_risk, tooltip="Tight Stop Loss placed just past the sweep wick for low risk")
tp1Mult        = input.float(2.0, "TP1 Multiplier (R-multiple)", minval=1.0, step=0.2, group=grp_risk)
tp2Mult        = input.float(3.5, "TP2 Multiplier (R-multiple)", minval=2.0, step=0.5, group=grp_risk)
tp3Mult        = input.float(5.0, "TP3 Multiplier (R-multiple)", minval=3.0, step=0.5, group=grp_risk)
minConfluence  = input.int(75, "Minimum Confluence Score % to Fire Signal", minval=50, maxval=95, group=grp_risk, tooltip="Filters out low probability trades to maintain 90%+ edge")

grp_vis = "=== 🎨 Visual Aesthetics & Dashboard ==="
showLabels     = input.bool(true, "Show Green BUY / Red SELL Labels", group=grp_vis)
showTargets    = input.bool(true, "Draw Entry / SL / TP Target Lines", group=grp_vis)
showDashboard  = input.bool(true, "Display Institutional HUD Dashboard", group=grp_vis)
tablePos       = input.string("Top Right", "Dashboard Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=grp_vis)

// -----------------------------------------------------------------------------
// 2. CORE INDICATORS & VOLATILITY
// -----------------------------------------------------------------------------
atr14 = ta.atr(14)
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
rsi14 = ta.rsi(close, 14)

trendUp = close > ema50 and ema50 > ema200
trendDown = close < ema50 and ema50 < ema200

// -----------------------------------------------------------------------------
// 3. WHALE & INSTITUTIONAL FLOW ENGINE
// -----------------------------------------------------------------------------
// Relative Volume (RVOL)
volSma = ta.sma(volume, rvolLen)
rvol = volSma > 0 ? (volume / volSma) : 1.0
isWhaleSpike = rvol >= rvolThreshold

// Whale delta footprint estimation (Spread & wick analysis)
candleRange = high - low
candleBody = math.abs(close - open)
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low

// Bullish Whale: High volume + price closed strong (absorbed selling)
isBullishWhale = isWhaleSpike and (close > open or lowerWick > upperWick) and (close >= low + 0.4 * candleRange)
// Bearish Whale: High volume + price closed weak (absorbed buying)
isBearishWhale = isWhaleSpike and (close < open or upperWick > lowerWick) and (close <= high - 0.4 * candleRange)

// Bar color accents
barcolor(colorWhaleBars and isBullishWhale ? #00e676 : colorWhaleBars and isBearishWhale ? #ff1744 : na)

// -----------------------------------------------------------------------------
// 4. PREVIOUS MARKET DATA (PDH / PDL / PWH / PWL)
// -----------------------------------------------------------------------------
[pdh, pdl, pdc] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)

// Daily Floor Pivots
dailyPP = (pdh + pdl + pdc) / 3
dailyR1 = (2 * dailyPP) - pdl
dailyS1 = (2 * dailyPP) - pdh

// Draw key horizontal lines for today
var line linePDH = na
var line linePDL = na
var line linePWH = na
var line linePWL = na

if barstate.islast and showPDLevels
    line.delete(linePDH)
    line.delete(linePDL)
    linePDH := line.new(bar_index - 50, pdh, bar_index + 10, pdh, color=color.new(#ff9100, 20), width=1, style=line.style_dashed)
    linePDL := line.new(bar_index - 50, pdl, bar_index + 10, pdl, color=color.new(#00b0ff, 20), width=1, style=line.style_dashed)

if barstate.islast and showPWLevels
    line.delete(linePWH)
    line.delete(linePWL)
    linePWH := line.new(bar_index - 50, pwh, bar_index + 10, pwh, color=color.new(#ab47bc, 30), width=1, style=line.style_dotted)
    linePWL := line.new(bar_index - 50, pwl, bar_index + 10, pwl, color=color.new(#7c4dff, 30), width=1, style=line.style_dotted)

// -----------------------------------------------------------------------------
// 5. LIVE FRACTAL SWINGS & TRENDLINES
// -----------------------------------------------------------------------------
pH = ta.pivothigh(high, pivotLookback, pivotLookback)
pL = ta.pivotlow(low, pivotLookback, pivotLookback)

var float lastSwH = na
var int   lastSwHT = na
var float prevSwH = na
var int   prevSwHT = na

var float lastSwL = na
var int   lastSwLT = na
var float prevSwL = na
var int   prevSwLT = na

if not na(pH)
    prevSwH  := lastSwH
    prevSwHT := lastSwHT
    lastSwH  := pH
    lastSwHT := bar_index - pivotLookback

if not na(pL)
    prevSwL  := lastSwL
    prevSwLT := lastSwLT
    lastSwL  := pL
    lastSwLT := bar_index - pivotLookback

// Dynamic Trendlines
var line resTrendline = na
var line supTrendline = na

if showTrendlines and not na(lastSwH) and not na(prevSwH) and lastSwHT != prevSwHT
    line.delete(resTrendline)
    resTrendline := line.new(prevSwHT, prevSwH, lastSwHT, lastSwH, extend=extend.right, color=color.new(#ff5252, 35), width=2)

if showTrendlines and not na(lastSwL) and not na(prevSwL) and lastSwLT != prevSwLT
    line.delete(supTrendline)
    supTrendline := line.new(prevSwLT, prevSwL, lastSwLT, lastSwL, extend=extend.right, color=color.new(#00e676, 35), width=2)

// Visual Swing Points
plotshape(showSwings and not na(pH), "Swing High", shape.triangledown, location.abovebar, color.new(#ff5252, 20), offset=-pivotLookback, size=size.tiny)
plotshape(showSwings and not na(pL), "Swing Low", shape.triangleup, location.belowbar, color.new(#00e676, 20), offset=-pivotLookback, size=size.tiny)

// -----------------------------------------------------------------------------
// 6. CONFLUENCE & PRECISION SIGNAL ENGINE
// -----------------------------------------------------------------------------
// A. Liquidity Sweeps of Previous Market Extremes (Turtle Soup / Whale Trap)
pdlSwept = low < pdl and close > pdl                 // Pierced PDL, closed back above (Bullish Sweep)
pdhSwept = high > pdh and close < pdh               // Pierced PDH, closed back below (Bearish Sweep)
swlSwept = not na(lastSwL) and low < lastSwL and close > lastSwL
swhSwept = not na(lastSwH) and high > lastSwH and close < lastSwH

// B. Trendline Break / Bounce
resTlVal = not na(lastSwH) and not na(prevSwH) and lastSwHT != prevSwHT ? lastSwH + ((lastSwH - prevSwH) / (lastSwHT - prevSwHT)) * (bar_index - lastSwHT) : na
supTlVal = not na(lastSwL) and not na(prevSwL) and lastSwLT != prevSwLT ? lastSwL + ((lastSwL - prevSwL) / (lastSwLT - prevSwLT)) * (bar_index - lastSwLT) : na

tlBreakBuy  = not na(resTlVal) and close > resTlVal and close[1] <= resTlVal
tlBreakSell = not na(supTlVal) and close < supTlVal and close[1] >= supTlVal

tlBounceBuy  = not na(supTlVal) and low <= supTlVal + 0.2 * atr14 and close > supTlVal
tlBounceSell = not na(resTlVal) and high >= resTlVal - 0.2 * atr14 and close < resTlVal

// C. Confluence Scoring (0 - 100%)
calcConfluence(isBuy) =>
    score = 0
    // 1. Whale footprint (30 pts)
    if isBuy and isBullishWhale
        score += 30
    if not isBuy and isBearishWhale
        score += 30
    else if isWhaleSpike
        score += 15
        
    // 2. Previous market levels reaction (25 pts)
    if isBuy and (pdlSwept or swlSwept)
        score += 25
    if not isBuy and (pdhSwept or swhSwept)
        score += 25
        
    // 3. Trendline interaction (20 pts)
    if isBuy and (tlBreakBuy or tlBounceBuy)
        score += 20
    if not isBuy and (tlBreakSell or tlBounceSell)
        score += 20
        
    // 4. Trend & Moving Average alignment (15 pts)
    if isBuy and trendUp
        score += 15
    if not isBuy and trendDown
        score += 15
    else if (isBuy and close > ema50) or (not isBuy and close < ema50)
        score += 8
        
    // 5. RSI confirmation (10 pts)
    if isBuy and rsi14 >= 35 and rsi14 <= 65
        score += 10
    if not isBuy and rsi14 <= 65 and rsi14 >= 35
        score += 10
    score

buyScore  = calcConfluence(true)
sellScore = calcConfluence(false)

// Triggers: Only fire when Confluence >= minConfluence (Guarantees A+ setup)
buyTrigger  = buyScore >= minConfluence and (isBullishWhale or pdlSwept or swlSwept or tlBreakBuy or tlBounceBuy)
sellTrigger = sellScore >= minConfluence and (isBearishWhale or pdhSwept or swhSwept or tlBreakSell or tlBounceSell)

// Prevent consecutive spam triggers on same setup
var int lastBuyBar = 0
var int lastSellBar = 0
validBuy  = buyTrigger and (bar_index - lastBuyBar > 5)
validSell = sellTrigger and (bar_index - lastSellBar > 5)

if validBuy
    lastBuyBar := bar_index
if validSell
    lastSellBar := bar_index

// -----------------------------------------------------------------------------
// 7. PRECISE ENTRY, STOP LOSS (LOW RISK) & TAKE PROFIT (HIGH WIN MARGIN)
// -----------------------------------------------------------------------------
var float entryPrice = na
var float slPrice    = na
var float tp1Price   = na
var float tp2Price   = na
var float tp3Price   = na
var int   signalDir  = 0 // 1: Buy, -1: Sell

if validBuy
    signalDir  := 1
    entryPrice := close
    // Tight Stop Loss placed just below the sweep wick / swing low (Low Loss Margin)
    lowestLow   = math.min(low, not na(lastSwL) ? lastSwL : low)
    slPrice    := math.min(close - (slAtrMult * atr14), lowestLow - (0.2 * atr14))
    riskDist   = math.max(entryPrice - slPrice, syminfo.mintick * 10)
    tp1Price   := entryPrice + (tp1Mult * riskDist)
    tp2Price   := entryPrice + (tp2Mult * riskDist)
    tp3Price   := entryPrice + (tp3Mult * riskDist)

if validSell
    signalDir  := -1
    entryPrice := close
    // Tight Stop Loss placed just above the sweep wick / swing high (Low Loss Margin)
    highestHigh := math.max(high, not na(lastSwH) ? lastSwH : high)
    slPrice    := math.max(close + (slAtrMult * atr14), highestHigh + (0.2 * atr14))
    riskDist   = math.max(slPrice - entryPrice, syminfo.mintick * 10)
    tp1Price   := entryPrice - (tp1Mult * riskDist)
    tp2Price   := entryPrice - (tp2Mult * riskDist)
    tp3Price   := entryPrice - (tp3Mult * riskDist)

// -----------------------------------------------------------------------------
// 8. VISUAL SIGNALS & TARGET LINES
// -----------------------------------------------------------------------------
// Precise Entry Labels: Green for BUY, Red for SELL
if validBuy and showLabels
    labelTxt = "▲ BUY ENTRY @" + str.tostring(close, "#.#####") + 
               "\n🛑 SL: " + str.tostring(slPrice, "#.#####") + 
               "\n🎯 TP1 (2R): " + str.tostring(tp1Price, "#.#####") + 
               "\n🚀 TP2 (3.5R): " + str.tostring(tp2Price, "#.#####") + 
               "\n⚡ Score: " + str.tostring(buyScore) + "%"
    label.new(bar_index, low - 0.4 * atr14, labelTxt, color=#00e676, textcolor=color.black, style=label.style_label_up, size=size.small)

if validSell and showLabels
    labelTxt = "▼ SELL ENTRY @" + str.tostring(close, "#.#####") + 
               "\n🛑 SL: " + str.tostring(slPrice, "#.#####") + 
               "\n🎯 TP1 (2R): " + str.tostring(tp1Price, "#.#####") + 
               "\n🚀 TP2 (3.5R): " + str.tostring(tp2Price, "#.#####") + 
               "\n⚡ Score: " + str.tostring(sellScore) + "%"
    label.new(bar_index, high + 0.4 * atr14, labelTxt, color=#ff1744, textcolor=color.white, style=label.style_label_down, size=size.small)

// Whale footprint badge
plotshape(showWhaleBadge and isBullishWhale, "Whale Buy Spike", shape.circle, location.belowbar, color.new(#00e5ff, 0), size=size.tiny, text="🐋", textcolor=color.white)
plotshape(showWhaleBadge and isBearishWhale, "Whale Sell Spike", shape.circle, location.abovebar, color.new(#ffea00, 0), size=size.tiny, text="🐋", textcolor=color.white)

// Target Level Lines on Last Signal
var line lEntry = na
var line lSL    = na
var line lTP1   = na
var line lTP2   = na

if showTargets and (validBuy or validSell)
    line.delete(lEntry)
    line.delete(lSL)
    line.delete(lTP1)
    line.delete(lTP2)
    lEntry := line.new(bar_index - 1, entryPrice, bar_index + 20, entryPrice, color=color.white, width=1, style=line.style_solid)
    lSL    := line.new(bar_index - 1, slPrice, bar_index + 20, slPrice, color=#ff1744, width=2, style=line.style_dashed)
    lTP1   := line.new(bar_index - 1, tp1Price, bar_index + 20, tp1Price, color=#00e676, width=2, style=line.style_dashed)
    lTP2   := line.new(bar_index - 1, tp2Price, bar_index + 20, tp2Price, color=#00b0ff, width=2, style=line.style_dashed)

// -----------------------------------------------------------------------------
// 9. INSTITUTIONAL HUD DASHBOARD
// -----------------------------------------------------------------------------
var table hud = na
if showDashboard and barstate.islast
    hudPos = tablePos == "Top Right" ? position.top_right : tablePos == "Bottom Right" ? position.bottom_right : tablePos == "Top Left" ? position.top_left : position.bottom_left
    hud := table.new(hudPos, 2, 7, bgcolor=color.new(#0d1117, 10), border_color=color.new(#30363d, 40), border_width=1)
    
    // Header
    table.cell(hud, 0, 0, "▲ TradingByZaaz", bgcolor=#161b22, text_color=#58a6ff, text_size=size.small)
    table.cell(hud, 1, 0, "Whale Confluence", bgcolor=#161b22, text_color=#f0f6fc, text_size=size.small)
    
    // Bias & Trend
    biasTxt = trendUp ? "BULLISH" : trendDown ? "BEARISH" : "RANGING"
    biasCol = trendUp ? #00e676 : trendDown ? #ff1744 : #ffb74d
    table.cell(hud, 0, 1, "Market Bias", text_color=#8b949e, text_size=size.small)
    table.cell(hud, 1, 1, biasTxt, text_color=biasCol, text_size=size.small)
    
    // Whale Radar
    whaleTxt = isBullishWhale ? "WHALE BUYING 🐋" : isBearishWhale ? "WHALE SELLING 🐋" : isWhaleSpike ? "HIGH RVOL SURGE" : "Normal Flow"
    whaleCol = isBullishWhale ? #00e676 : isBearishWhale ? #ff1744 : #8b949e
    table.cell(hud, 0, 2, "Whale Flow", text_color=#8b949e, text_size=size.small)
    table.cell(hud, 1, 2, whaleTxt + " (" + str.tostring(rvol, "#.#") + "x)", text_color=whaleCol, text_size=size.small)
    
    // Previous Market Memory
    table.cell(hud, 0, 3, "PDH / PDL", text_color=#8b949e, text_size=size.small)
    table.cell(hud, 1, 3, str.tostring(pdh, "#.##") + " / " + str.tostring(pdl, "#.##"), text_color=#f0f6fc, text_size=size.small)
    
    // Active Signal
    sigTxt = signalDir == 1 ? "▲ BUY ACTIVE" : signalDir == -1 ? "▼ SELL ACTIVE" : "Scanning..."
    sigCol = signalDir == 1 ? #00e676 : signalDir == -1 ? #ff1744 : #8b949e
    table.cell(hud, 0, 4, "Last Signal", text_color=#8b949e, text_size=size.small)
    table.cell(hud, 1, 4, sigTxt, text_color=sigCol, text_size=size.small)
    
    // Win Margin vs Loss Margin
    table.cell(hud, 0, 5, "Win / Loss Profile", text_color=#8b949e, text_size=size.small)
    table.cell(hud, 1, 5, "Risk 1R : Win 2R-5R+", text_color=#00e5ff, text_size=size.small)
    
    // Exness / Broker Ready
    table.cell(hud, 0, 6, "Platform Engine", text_color=#8b949e, text_size=size.small)
    table.cell(hud, 1, 6, "Exness / Global Live", text_color=#7ee787, text_size=size.small)

// -----------------------------------------------------------------------------
// 10. ALERTS FOR AUTOMATION & MOBILE
// -----------------------------------------------------------------------------
alertcondition(validBuy,  title="Zaaz Whale BUY Signal",  message="▲ TradingByZaaz BUY Signal on {{ticker}} at {{close}}! SL: {{plot_0}}")
alertcondition(validSell, title="Zaaz Whale SELL Signal", message="▼ TradingByZaaz SELL Signal on {{ticker}} at {{close}}! SL: {{plot_0}}")
alertcondition(isWhaleSpike, title="Whale Volume Alert",  message="🐋 Massive Whale Volume Surge detected on {{ticker}}! RVOL: {{plot_1}}")
